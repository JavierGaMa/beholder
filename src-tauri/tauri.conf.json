{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Beholder",
  "version": "0.1.0",
  "identifier": "dev.beholder.app",
  "build": {
    "beforeDevCommand": "node scripts/build-sidecar.mjs --dev && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/build-sidecar.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Beholder",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/beholder-mcp"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "PASTE_TAURI_SIGNING_PUBKEY",
      "endpoints": [
        "https://github.com/JavierGaMa/beholder/releases/latest/download/latest.json"
      ]
    }
  }
}
